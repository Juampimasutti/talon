{
  "name": "talon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev --hostname 0.0.0.0 --port 4317",
    "build": "next build",
    "build:standalone": "next build && node scripts/package-standalone.mjs",
    "start": "node scripts/serve.mjs start --hostname 0.0.0.0 --port 4317",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run src/lib/db/rls.integration.test.ts src/lib/db/impuestos-rls.integration.test.ts",
    "test:flows": "npm run build && RUN_FLOW_TESTS=1 vitest run src/lib/db/business-flows.integration.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "talon:modo": "tsx scripts/talon-modo.ts",
    "db:explain": "tsx scripts/explain.ts",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "measure:renders": "vitest run src/lib/ui/render-budget.test.tsx",
    "local": "tsx scripts/local.ts",
    "demo:setup": "tsx scripts/demo-fija.ts",
    "demo": "tsx scripts/demo-fija.ts --serve",
    "local:prod": "next build && node scripts/shell-assets.mjs && node scripts/serve.mjs start --hostname 0.0.0.0 --port 4318",
    "empresa:autorizar": "tsx scripts/company-operator.ts",
    "respaldos:ahora": "node scripts/backup-worker.mjs --once",
    "respaldos:auto": "node scripts/backup-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.545.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^20.0.10",
    "sharp": "^0.34.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
